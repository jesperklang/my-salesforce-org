{
  // General Settings
  "search.exclude": {
    "**/node_modules": true,
    "**/bower_components": true,
    "**/.sf": true,
    "**/.sfdx": true,
    "**/coverage": true
  },
  "xml.preferences.showSchemaDocumentationType": "none",

  // Editor Settings
  "editor.detectIndentation": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",

  // Task Settings
  "task.allowAutomaticTasks": "on",

  // Telemetry Settings
  "telemetry.feedback.enabled": false,
  "telemetry.editStats.details.enabled": false,
  "telemetry.editStats.enabled": false,
  "salesforcedx-vscode-core.telemetry.enabled": false,
  "redhat.telemetry.enabled": false,

  // Git Settings
  "git.allowForcePush": true,
  "git.autofetch": true,
  "git.branchPrefix": "feature/",
  "git.branchProtection": ["main", "master"],

  // LLM Settings
  "chat.tools.urls.autoApprove": {
    // VS Code URLs
    "https://code.visualstudio.com/docs/*": {
      "approveRequest": true,
      "approveResponse": true,
    },
    "https://code.visualstudio.com/api/*": {
      "approveRequest": true,
      "approveResponse": true,
    },
    // Salesforce URLs
    "https://developer.salesforce.com*": {
      "approveRequest": true,
      "approveResponse": true,
    },
    "https://help.salesforce.com*": {
      "approveRequest": true,
      "approveResponse": true,
    },
    "https://architect.salesforce.com*": {
      "approveRequest": true,
      "approveResponse": true,
    },
    "https://admin.salesforce.com*": {
      "approveRequest": true,
      "approveResponse": true,
    },
    "https://lightningdesignsystem.com*": {
      "approveRequest": true,
      "approveResponse": true,
    },
    "https://v1.lightningdesignsystem.com*": {
      "approveRequest": true,
      "approveResponse": true,
    }
  },

  // Salesforce Settings
  "files.associations": {
    "*.apex": "apex-anon",
  },
  "salesforcedx-vscode-lwc.preview.typeScriptSupport": true,
  "salesforcedx-vscode-metadata.sourceTracking.enableConflictDetection": false,

  // Hardis Settings
  "vsCodeSfdxHardis.colorUpdateLocation": "User",
  "vsCodeSfdxHardis.theme.colorTheme": "auto",
  "vsCodeSfdxHardis.theme.menuIconType": "vscode",

  // Better Todo Tree Settings
  "better-todo-tree.general.showActivityBarBadge": true,
  "better-todo-tree.general.statusBar": "current file",
  "better-todo-tree.general.tags": ["BUG", "HACK", "FIXME", "TODO"],
  "better-todo-tree.tree.expanded": true,
  "better-todo-tree.filtering.includeHiddenFiles": true,
  "chat.useNestedAgentsMdFiles": true,
}
