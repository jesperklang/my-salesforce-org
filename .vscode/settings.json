{
  // General Settings
  "search.followSymlinks": false,
  "search.exclude": {
    "**/node_modules": true,
    "**/bower_components": true,
    "**/.sf": true,
    "**/.sfdx": true,
    "**/coverage": true,
    "**/hardis-report": true,
  },
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/bower_components/**": true,
    "**/.sf/**": true,
    "**/.sfdx/**": true,
    "**/coverage/**": true,
    "**/hardis-report/**": true,
  },
  "xml.preferences.showSchemaDocumentationType": "none",
  "extensions.ignoreRecommendations": true,

  // Editor Settings
  "editor.detectIndentation": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",

  // Telemetry Settings
  "telemetry.feedback.enabled": false,
  "salesforcedx-vscode-core.telemetry.enabled": false,
  "redhat.telemetry.enabled": false,

  // Git Settings
  "git.allowForcePush": true,
  "git.autofetch": true,
  "git.branchPrefix": "feature/",
  "git.branchProtection": ["main", "master"],

  // LLM Settings
  "chat.tools.urls.autoApprove": {
    // Auto-approve Salesforce URLs
    "https://developer.salesforce.com/docs/*": true,
    "https://help.salesforce.com/*": true,
    "https://architect.salesforce.com/*": true,
    "https://admin.salesforce.com/*": true,
    "https://lightningdesignsystem.com/*": true,
    "https://v1.lightningdesignsystem.com/*": true,
    "https://developer.salesforce.com/docs/atlas.en-us.*": true
  },

  // Salesforce Settings
  "salesforcedx-vscode-apex.autoTerminateOrphanedProcesses": true,
  "files.associations": {
    "*.apex": "apex-anon",
  },

  // Other Extension Settings
  "cSpell.spellCheckOnlyWorkspaceFiles": true,
  "vsCodeSfdxHardis.colorUpdateLocation": "User",
  "vsCodeSfdxHardis.theme.menuIconType": "vscode",
  "better-todo-tree.general.showActivityBarBadge": true,
  "better-todo-tree.general.statusBar": "current file",
  "better-todo-tree.general.tags": ["BUG", "HACK", "FIXME", "TODO"],
  "better-todo-tree.tree.expanded": true,
  "better-todo-tree.filtering.includeHiddenFiles": true,
  "better-todo-tree.filtering.useBuiltInExcludes": "file and search excludes",

}
