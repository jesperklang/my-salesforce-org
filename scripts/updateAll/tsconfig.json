{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "allowImportingTsExtensions": true,
        "erasableSyntaxOnly": true,
        "types": ["node"],
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true
    },
    "include": ["*.ts", "lib/**/*.ts"]
}
